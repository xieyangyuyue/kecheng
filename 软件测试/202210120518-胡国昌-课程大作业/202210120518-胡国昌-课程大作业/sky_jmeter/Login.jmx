        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="register">
          <stringProp name="HTTPSampler.domain">111.170.11.164</stringProp>
          <stringProp name="HTTPSampler.port">10700</stringProp>
          <stringProp name="HTTPSampler.path">/admin/employee</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
